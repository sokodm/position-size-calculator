# Your live portfolio: sizes, entry prices, risk settings. Never commit this --
# it is personal financial data, and each person needs their own copy anyway.
positions.json

# Streamlit's run log. Contains your portfolio size in plain text.
streamlit.log

# ~435 MB, and built for one specific OS -- it will not work on another.
.venv/

# The private Python the launchers download when the machine has none. Same
# story: one specific OS and processor, so it never belongs in the repo.
.runtime/

# Launcher step logs, crash reports and the generated HTML diagnostics. They
# name local paths and are specific to one machine's failure.
logs/

__pycache__/
*.py[cod]

.DS_Store

# Subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/
